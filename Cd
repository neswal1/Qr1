<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Heart Gesture Particles</title>
    <style>
        body { margin: 0; overflow: hidden; background: radial-gradient(circle, #1a0a0a 0%, #050505 100%); font-family: 'Segoe UI', sans-serif; }
        #canvas-container { width: 100vw; height: 100vh; }
        #video-container {
            position: absolute; bottom: 20px; right: 20px;
            width: 200px; height: 150px; border-radius: 15px;
            overflow: hidden; border: 2px solid rgba(255, 50, 50, 0.3);
            transform: scaleX(-1); box-shadow: 0 0 20px rgba(0,0,0,0.5);
        }
        video { width: 100%; height: 100%; object-fit: cover; }
        .ui-overlay {
            position: absolute; top: 30px; left: 30px; color: #ff4d4d;
            pointer-events: none; text-transform: uppercase; letter-spacing: 3px;
        }
        .ui-overlay h1 { margin: 0; font-size: 1.8rem; text-shadow: 0 0 10px rgba(255,0,0,0.5); }
        .ui-overlay p { color: white; opacity: 0.6; font-size: 0.8rem; margin-top: 5px; }
    </style>
</head>
<body>

    <div class="ui-overlay">
        <h1>Heart Mathematical</h1>
        <p>Khoảng cách 2 tay điều khiển nhịp đập trái tim</p>
    </div>

    <div id="video-container">
        <video id="webcam" autoplay playsinline></video>
    </div>

    <div id="canvas-container"></div>

    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
            }
        }
    </script>

    <script type="module">
        import * as THREE from 'three';
        import { GUI } from 'three/addons/libs/lil-gui.module.min.js';

        let scene, camera, renderer, particles;
        let particleData = [];
        const PARTICLE_COUNT = 8000; 
        let expansionFactor = 0;
        const settings = { color: 0xff2d55, size: 0.04 };

        function initThree() {
            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 0, 4);

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            document.getElementById('canvas-container').appendChild(renderer.domElement);

            const geometry = new THREE.BufferGeometry();
            const positions = new Float32Array(PARTICLE_COUNT * 3);
            
            // Hàm kiểm tra điểm có nằm trong/trên bề mặt trái tim không
            // Phương trình: (x^2 + 9/4y^2 + z^2 - 1)^3 - x^2z^3 - 9/80y^2z^3 = 0
            let i = 0;
            while (i < PARTICLE_COUNT) {
                // Lấy mẫu ngẫu nhiên trong khối [-1.5, 1.5]
                const x = (Math.random() - 0.5) * 3;
                const y = (Math.random() - 0.5) * 3;
                const z = (Math.random() - 0.5) * 3;

                const x2 = x * x;
                const y2 = y * y;
                const z2 = z * z;

                // Công thức tính f(x,y,z)
                const term1 = x2 + (9/4)*y2 + z2 - 1;
                const f = Math.pow(term1, 3) - x2*Math.pow(z, 3) - (9/80)*y2*Math.pow(z, 3);

                // Nếu f < 0, điểm nằm bên trong hoặc sát bề mặt trái tim
                if (f < 0) {
                    particleData.push({
                        heartX: x, heartY: z, heartZ: y, // Đổi trục để trái tim đứng thẳng
                        randomX: (Math.random() - 0.5) * 15,
                        randomY: (Math.random() - 0.5) * 15,
                        randomZ: (Math.random() - 0.5) * 15
                    });
                    i++;
                }
            }

            geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            const material = new THREE.PointsMaterial({
                color: settings.color,
                size: settings.size,
                transparent: true,
                blending: THREE.AdditiveBlending,
                depthWrite: false
            });

            particles = new THREE.Points(geometry, material);
            scene.add(particles);

            const gui = new GUI();
            gui.addColor(settings, 'color').name('Màu Trái Tim').onChange(v => material.color.set(v));
            gui.add(settings, 'size', 0.01, 0.1).name('Cỡ Hạt');

            window.addEventListener('resize', onWindowResize);
        }

        async function setupHands() {
            await loadScript("https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js");
            await loadScript("https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js");

            const videoElement = document.getElementById('webcam');
            const hands = new window.Hands({
                locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
            });

            hands.setOptions({ maxNumHands: 2, modelComplexity: 1, minDetectionConfidence: 0.6 });
            hands.onResults(results => {
                if (results.multiHandLandmarks && results.multiHandLandmarks.length >= 2) {
                    const h1 = results.multiHandLandmarks[0][0];
                    const h2 = results.multiHandLandmarks[1][0];
                    const dist = Math.hypot(h1.x - h2.x, h1.y - h2.y);
                    expansionFactor = THREE.MathUtils.clamp((dist - 0.15) / 0.5, 0, 1);
                } else {
                    expansionFactor = THREE.MathUtils.lerp(expansionFactor, 0, 0.05);
                }
            });

            const cameraPipe = new window.Camera(videoElement, {
                onFrame: async () => { await hands.send({image: videoElement}); },
                width: 640, height: 480
            });
            cameraPipe.start();
        }

        function animate() {
            requestAnimationFrame(animate);
            const pos = particles.geometry.attributes.position.array;
            
            for (let i = 0; i < PARTICLE_COUNT; i++) {
                const d = particleData[i];
                const i3 = i * 3;
                
                const tx = THREE.MathUtils.lerp(d.heartX, d.randomX, expansionFactor);
                const ty = THREE.MathUtils.lerp(d.heartY, d.randomY, expansionFactor);
                const tz = THREE.MathUtils.lerp(d.heartZ, d.randomZ, expansionFactor);

                pos[i3] += (tx - pos[i3]) * 0.1;
                pos[i3+1] += (ty - pos[i3+1]) * 0.1;
                pos[i3+2] += (tz - pos[i3+2]) * 0.1;
            }
            
            particles.geometry.attributes.position.needsUpdate = true;
            particles.rotation.y += 0.005;
            renderer.render(scene, camera);
        }

        function loadScript(url) {
            return new Promise(r => { const s = document.createElement('script'); s.src = url; s.onload = r; document.head.appendChild(s); });
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        initThree();
        setupHands();
        animate();
    </script>
</body>
</html>
